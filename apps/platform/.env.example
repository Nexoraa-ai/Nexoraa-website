# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in browser — RLS enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (SERVER ONLY — never expose in browser or commit)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Convenience aliases used by scripts/test-pipeline.ts
SUPABASE_URL=https://your-project.supabase.co

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Used by: L0_04 (Haiku classification), L0_05 (Sonnet/Opus summarization), L0_06 (Haiku vertical panels)
# Models in use:
#   claude-haiku-4-5-20251001  — classification + vertical panels (~60% bypass via rules engine)
#   claude-sonnet-4-6           — summarization (priority 50-89)
#   claude-opus-4-7             — summarization (priority >= 90, ~2-5 items/day)
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (Embeddings) ──────────────────────────────────────────────────────
# Used by: L0_03 (text-embedding-3-small, 1536d, input = title + excerpt, cap 150 tokens)
# Cost: ~$0.00002/cluster (10x cheaper than using full_text)
OPENAI_API_KEY=sk-...

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Used by: L0_08 (daily digest email delivery)
# From address: NeuralForge <digest@neuralforge.io>
# Configure domain at resend.com/domains before use
RESEND_API_KEY=re_...

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Base URL of your n8n instance (Railway deployment)
# Used by: L0_01, L0_04, L0_05 to trigger downstream webhooks
# Example: https://neuralforge-n8n.railway.app
N8N_WEBHOOK_BASE_URL=https://your-n8n.railway.app

# Shared secret for authenticating webhook calls from n8n to this app
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# ─── Apify (X/Twitter scraping) ───────────────────────────────────────────────
# Used by: L0_02 (apify/twitter-scraper, runs once daily at 06:00 IST)
# Cost: ~$80/mo at daily polling vs ~$150/mo at 15-min polling
APIFY_API_KEY=apify_api_...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.neuralforge.io

# ─── Notes ───────────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local — it is in .gitignore
# 3. For production, set these in Vercel → Settings → Environment Variables
# 4. SUPABASE_SERVICE_ROLE_KEY must ONLY be set as a server-side env var (no NEXT_PUBLIC_ prefix)
# 5. n8n workflows use $env.VARIABLE_NAME syntax for the same secrets
